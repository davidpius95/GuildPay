# Set to "true" to allow sandbox fallbacks when provider APIs fail (NEVER enable in production)
DEMO_MODE=true

# Database
DATABASE_URL=postgresql://guildpay:guildpay_dev_2024@localhost:5432/guildpay

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_REFRESH_SECRET=change-this-to-another-secret

# ─── Nium (Global Infrastructure: Gulf collection, FX, cards, KYC, payouts) ───
# Sandbox: https://gateway.nium.com/api | Production: https://api.spend.nium.com/api
NIUM_API_BASE_URL=https://gateway.nium.com/api
NIUM_CLIENT_HASH_ID=your-client-hash-id
NIUM_API_KEY=your-nium-api-key
NIUM_WEBHOOK_SECRET=your-nium-webhook-secret

# ─── Flutterwave (African last-mile: collections, mobile money, bills, payouts) ───
# v3 base URL: https://api.flutterwave.com/v3
FLUTTERWAVE_API_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxx
FLUTTERWAVE_ENCRYPTION_KEY=xxxxx
FLUTTERWAVE_WEBHOOK_HASH=your-flw-webhook-hash

# Blockchain (Base/USDC)
ETHEREUM_RPC_URL=https://mainnet.base.org
WALLET_PRIVATE_KEY=

# App
APP_URL=https://pay.guildpay.com
CORS_ORIGIN=*
PORT=3001
NODE_ENV=development

# Go Payment Service
PAYMENT_SVC_GRPC=localhost:50051
PAYMENT_SVC_HTTP=http://localhost:3002
