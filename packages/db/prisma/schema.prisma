generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH & USERS ───

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?   @unique
  passwordHash  String
  pin           String?   // 6-digit hashed passcode
  biometricKey  String?
  role          UserRole  @default(USER)
  status        UserStatus @default(PENDING_VERIFICATION)
  emailVerified Boolean   @default(false)
  phoneVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       UserProfile?
  kycDocuments  KycDocument[]
  wallets       Wallet[]
  recipients    Recipient[]
  paymentMethods PaymentMethod[]
  virtualCards  VirtualCard[]
  notifications Notification[]
  sessions      Session[]
  otpCodes      OtpCode[]
  referralCode  String?   @unique
  referredBy    String?
  referrals     Referral[] @relation("Referrer")

  @@map("users")
}

model UserProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  firstName   String
  lastName    String
  country     String
  state       String?
  dateOfBirth DateTime?
  avatarUrl   String?
  address     String?
  city        String?
  postalCode  String?
  kycTier     KycTier @default(TIER_0)
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model KycDocument {
  id           String      @id @default(cuid())
  userId       String
  type         KycDocType
  frontUrl     String
  backUrl      String?
  selfieUrl    String?
  status       KycStatus   @default(PENDING)
  rejectedReason String?
  verifiedAt   DateTime?
  createdAt    DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kyc_documents")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  device    String?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model OtpCode {
  id        String   @id @default(cuid())
  userId    String
  code      String
  type      OtpType
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otp_codes")
}

// ─── WALLET & FINANCIAL ───

model Wallet {
  id                  String   @id @default(cuid())
  userId              String
  status              WalletStatus @default(ACTIVE)
  niumCustomerHashId  String?  // Nium customer ID for KYC/payouts
  niumWalletHashId    String?  // Nium wallet ID for cards/FX
  createdAt           DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balances  WalletBalance[]

  @@unique([userId])
  @@map("wallets")
}

model WalletBalance {
  id        String   @id @default(cuid())
  walletId  String
  currency  String   // USD, NGN, GBP, EUR, AED, SAR, QAR, GHS, KES, ZAR, USDT, USDC
  balance   Decimal  @default(0) @db.Decimal(18, 8)
  locked    Decimal  @default(0) @db.Decimal(18, 8) // funds in pending txns
  updatedAt DateTime @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, currency])
  @@map("wallet_balances")
}

model LedgerEntry {
  id            String      @id @default(cuid())
  transactionId String
  accountId     String      // wallet balance ID or system account
  accountType   AccountType
  entryType     EntryType   // DEBIT or CREDIT
  amount        Decimal     @db.Decimal(18, 8)
  currency      String
  balanceBefore Decimal     @db.Decimal(18, 8)
  balanceAfter  Decimal     @db.Decimal(18, 8)
  description   String?
  createdAt     DateTime    @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@index([transactionId])
  @@index([accountId])
  @@map("ledger_entries")
}

model Transaction {
  id              String          @id @default(cuid())
  userId          String
  type            TransactionType
  status          TransactionStatus @default(INITIATED)
  amount          Decimal         @db.Decimal(18, 8)
  currency        String
  fee             Decimal         @default(0) @db.Decimal(18, 8)
  feeCurrency     String?
  
  // For transfers
  recipientId     String?
  toAmount        Decimal?        @db.Decimal(18, 8)
  toCurrency      String?
  exchangeRate    Decimal?        @db.Decimal(18, 8)
  
  // Payment rail info
  provider        String?         // flutterwave, paystack, blockchain
  providerRef     String?         // external reference
  rail            PaymentRail?    // BANK_TRANSFER, CARD, MOBILE_MONEY, CRYPTO
  
  // Metadata
  note            String?
  metadata        Json?
  failedReason    String?
  
  // Timestamps
  initiatedAt     DateTime        @default(now())
  processedAt     DateTime?
  completedAt     DateTime?
  failedAt        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  ledgerEntries   LedgerEntry[]
  tracking        TransferTracking[]

  @@index([userId])
  @@index([status])
  @@index([type])
  @@map("transactions")
}

model TransferTracking {
  id            String   @id @default(cuid())
  transactionId String
  status        String   // initiated, processing, in_transit, delivered, failed
  message       String?
  timestamp     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@index([transactionId])
  @@map("transfer_tracking")
}

// ─── RECIPIENTS & PAYMENT METHODS ───

model Recipient {
  id            String  @id @default(cuid())
  userId        String
  name          String
  country       String
  countryCode   String  // ISO 3166-1 alpha-2
  bankName      String?
  bankCode      String?
  accountNumber String?
  mobileNumber  String?
  mobileProvider String? // M-Pesa, MTN MoMo, etc.
  walletAddress String? // crypto
  email         String?
  isFavorite    Boolean @default(false)
  lastUsedAt    DateTime?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recipients")
}

model PaymentMethod {
  id            String        @id @default(cuid())
  userId        String
  type          PaymentMethodType
  provider      String?       // visa, mastercard, gtbank
  label         String        // "Visa ****4829"
  last4         String?
  expiryMonth   Int?
  expiryYear    Int?
  bankName      String?
  accountNumber String?
  walletAddress String?
  network       String?       // for crypto: base, polygon
  isDefault     Boolean       @default(false)
  metadata      Json?
  createdAt     DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payment_methods")
}

// ─── VIRTUAL CARD ───

model VirtualCard {
  id            String    @id @default(cuid())
  userId        String
  provider      String    // sudo, flutterwave
  providerCardId String   @unique
  last4         String
  expiryMonth   Int
  expiryYear    Int
  currency      String    @default("USD")
  balance       Decimal   @default(0) @db.Decimal(18, 2)
  status        CardStatus @default(ACTIVE)
  spendingLimit Decimal?  @db.Decimal(18, 2)
  isFrozen      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  CardTransaction[]

  @@index([userId])
  @@map("virtual_cards")
}

model CardTransaction {
  id          String   @id @default(cuid())
  cardId      String
  type        String   // purchase, refund, funding, withdrawal
  amount      Decimal  @db.Decimal(18, 2)
  currency    String
  merchant    String?
  status      String   @default("completed")
  createdAt   DateTime @default(now())

  card VirtualCard @relation(fields: [cardId], references: [id])

  @@index([cardId])
  @@map("card_transactions")
}

// ─── BILLS & SERVICES ───

model BillPayment {
  id            String   @id @default(cuid())
  userId        String
  type          BillType // AIRTIME, DATA, ELECTRICITY, TV, INTERNET
  provider      String
  recipientId   String   // phone number or meter number
  amount        Decimal  @db.Decimal(18, 2)
  currency      String
  status        String   @default("pending")
  providerRef   String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@map("bill_payments")
}

// ─── NOTIFICATIONS ───

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

// ─── REFERRALS ───

model Referral {
  id          String   @id @default(cuid())
  referrerId  String
  refereeId   String   @unique
  rewardAmount Decimal @default(5) @db.Decimal(18, 2)
  rewardCurrency String @default("USD")
  status      String   @default("pending") // pending, completed, paid
  completedAt DateTime?
  createdAt   DateTime @default(now())

  referrer User @relation("Referrer", fields: [referrerId], references: [id])

  @@map("referrals")
}

// ─── FX RATES ───

model ExchangeRate {
  id         String   @id @default(cuid())
  fromCurrency String
  toCurrency String
  rate       Decimal  @db.Decimal(18, 8)
  source     String   // provider name
  updatedAt  DateTime @updatedAt

  @@unique([fromCurrency, toCurrency])
  @@map("exchange_rates")
}

// ─── PAYMENT LINKS ───

model PaymentLink {
  id        String   @id @default(cuid())
  userId    String
  slug      String   @unique
  amount    Decimal? @db.Decimal(18, 8)
  currency  String?
  note      String?
  isActive  Boolean  @default(true)
  expiresAt DateTime?
  createdAt DateTime @default(now())

  @@index([slug])
  @@map("payment_links")
}

// ─── ENUMS ───

enum UserRole {
  USER
  MERCHANT
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum KycTier {
  TIER_0  // unverified: $50/day limit
  TIER_1  // basic: $500/day
  TIER_2  // full: $5000/day
  TIER_3  // enhanced: unlimited
}

enum KycDocType {
  PASSPORT
  NATIONAL_ID
  DRIVERS_LICENSE
  UTILITY_BILL
  BANK_STATEMENT
  SELFIE
}

enum KycStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum OtpType {
  EMAIL_VERIFY
  PHONE_VERIFY
  PASSWORD_RESET
  TRANSACTION
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum AccountType {
  USER_WALLET
  SYSTEM_FEE
  SYSTEM_FLOAT
  PROVIDER
}

enum EntryType {
  DEBIT
  CREDIT
}

enum TransactionType {
  SEND
  RECEIVE
  TOPUP
  WITHDRAW
  EXCHANGE
  CARD_FUND
  CARD_WITHDRAW
  BILL_PAYMENT
  ONRAMP
  OFFRAMP
  REFERRAL_REWARD
}

enum TransactionStatus {
  INITIATED
  PROCESSING
  IN_TRANSIT
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

enum PaymentRail {
  BANK_TRANSFER
  CARD
  MOBILE_MONEY
  CRYPTO
  INTERNAL
}

enum PaymentMethodType {
  DEBIT_CARD
  CREDIT_CARD
  BANK_ACCOUNT
  MOBILE_MONEY
  CRYPTO_WALLET
}

enum CardStatus {
  ACTIVE
  FROZEN
  CANCELLED
  EXPIRED
}

enum BillType {
  AIRTIME
  DATA
  ELECTRICITY
  TV_CABLE
  INTERNET
  EDUCATION
}

enum NotificationType {
  TRANSACTION
  SECURITY
  PROMOTION
  SYSTEM
  KYC
}
